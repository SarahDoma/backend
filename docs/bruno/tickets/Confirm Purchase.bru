meta {
  name: Confirm Purchase
  type: http
}

post {
  url: {{baseUrl}}/v1/tickets/confirm-purchase
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "ticketTypeId": "00000000-0000-4000-8000-000000000000",
    "seat": "string",
    "promoCode": "string"
  }
}
