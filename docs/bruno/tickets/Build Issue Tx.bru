meta {
  name: Build Issue Tx
  type: http
}

post {
  url: {{baseUrl}}/v1/tickets/issue
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "ticketTypeId": "00000000-0000-4000-8000-000000000000",
    "toUserId": "00000000-0000-4000-8000-000000000000",
    "toPublicKey": "{{publicKey}}",
    "seat": "string"
  }
}
