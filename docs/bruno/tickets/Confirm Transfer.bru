meta {
  name: Confirm Transfer
  type: http
}

post {
  url: {{baseUrl}}/v1/tickets/{{ticketId}}/confirm-transfer
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "toUserId": "00000000-0000-4000-8000-000000000000",
    "toPublicKey": "{{publicKey}}"
  }
}
