generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_ADMIN
  ORGANIZER
  ATTENDEE
}

enum OrgMemberRole {
  OWNER
  ADMIN
  STAFF
}

/// Mirrors the 12 supported verticals. Kept as an enum on the backend (unlike
/// the contract's free-text `category`) so the dashboard/marketplace can
/// filter and render industry-specific copy without string matching.
enum Industry {
  CONCERTS
  FLIGHTS
  SPORTS
  FESTIVALS
  CONFERENCES
  BUS
  MOVIE_THEATERS
  MUSEUMS
  TOURIST_ATTRACTIONS
  PUBLIC_TRANSPORT
  UNIVERSITIES
  CORPORATE_EVENTS
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

/// Cached projection of the on-chain `TicketStatus`. The contract remains the
/// source of truth; this column exists so listing/search queries don't need
/// a Soroban RPC round trip, and is reconciled on every write path and by a
/// periodic reconciliation job.
enum TicketStatus {
  VALID
  USED
  REVOKED
  RESALE
}

enum ResaleListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

/// Position in a `WaitlistEntry` queue is derived from `createdAt` (FIFO), not
/// stored directly, so re-ordering never requires rewriting every row.
enum WaitlistEntryStatus {
  WAITING
  OFFERED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum PromoCodeDiscountType {
  PERCENT
  FIXED
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  name             String
  role             UserRole             @default(ATTENDEE)
  /// Stellar (G...) address used to receive tickets and settle payments.
  stellarPublicKey String?              @unique
  memberships      OrganizationMember[]
  tickets          Ticket[]
  resaleListings   ResaleListing[]
  eventReminders   EventReminder[]
  waitlistEntries  WaitlistEntry[]
  promoRedemptions PromoCodeRedemption[]
  auditLogs        AuditLog[]
  pendingTxs       PendingTx[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model Organization {
  id                             String               @id @default(uuid())
  name                           String
  slug                           String               @unique
  industry                       Industry
  /// Stellar (G...) address that signs `create_event`/`issue_ticket` calls
  /// and receives primary-sale + royalty payments for this organizer.
  stellarAccount String
  logoUrl        String?
  websiteUrl     String?
  /// Default `Event.maxResaleMultiplierBps` applied when a new event's DTO
  /// omits it.
  defaultMaxResaleMultiplierBps Int @default(11000)
  /// Default `Event.royaltyBps` applied when a new event's DTO omits it.
  defaultRoyaltyBps             Int @default(500)
  members        OrganizationMember[]
  events         Event[]
  webhookEndpoints WebhookEndpoint[]
  /// #207 — soft-delete marker. Null = live; non-null = deleted at that time.
  /// Rows are never hard-deleted by the app; queries filter `deletedAt: null`.
  deletedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model OrganizationMember {
  id             String        @id @default(uuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  role           OrgMemberRole @default(STAFF)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, userId])
}

model Event {
  id                     String          @id @default(uuid())
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String
  name                   String
  category               Industry
  venue                  String
  startsAt               DateTime
  endsAt                 DateTime?
  /// The `event_id` (u64) this event was registered under on the ticketing
  /// contract via `create_event`. Null until the on-chain call succeeds.
  chainEventId           BigInt?         @unique
  publishedTxHash        String?
  maxResaleMultiplierBps Int             @default(11000)
  royaltyBps             Int             @default(500)
  status                 EventStatus     @default(DRAFT)
  ticketTypes            TicketType[]
  tickets                Ticket[]
  reminders              EventReminder[]
  promoCodes             PromoCode[]
  gates                  Gate[]
  scannerDevices         ScannerDevice[]
  /// #207 — soft-delete marker. Null = live; non-null = deleted at that time.
  deletedAt              DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
}

model TicketType {
  id             String   @id @default(uuid())
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  name           String
  /// Face-value price in the platform's settlement token's smallest unit.
  price          BigInt
  quantityTotal  Int
  quantityIssued Int      @default(0)
  saleStartsAt   DateTime?
  saleEndsAt     DateTime?
  isHidden       Boolean  @default(false)
  tickets        Ticket[]
  waitlistEntries WaitlistEntry[]
  createdAt      DateTime @default(now())

  @@unique([eventId, name])
}

model Ticket {
  id             String          @id @default(uuid())
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId        String
  ticketType     TicketType      @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId   String
  owner          User            @relation(fields: [ownerId], references: [id])
  ownerId        String
  /// The `ticket_id` (u64) returned by `issue_ticket`/`purchase_primary`.
  chainTicketId  BigInt          @unique
  seat           String          @default("unassigned")
  status         TicketStatus    @default(VALID)
  /// Opaque per-ticket secret embedded in the scannable QR code; verification
  /// checks this against the DB *and* the on-chain owner/status before a gate
  /// scan is accepted, so a photographed QR code alone can't be reused.
  qrSecret       String          @unique @default(uuid())
  issuedTxHash   String?
  checkedInAt    DateTime?
  /// Reason for check-in when scanner fails and staff override is used.
  checkInReason  String?
  /// Which physical `Gate` this ticket was scanned at, if any. Null for
  /// tickets checked in before gates existed, or checked in through a
  /// non-gated flow.
  checkedInGate   Gate?           @relation(fields: [checkedInGateId], references: [id])
  checkedInGateId String?
  resaleListings ResaleListing[]
  promoRedemption PromoCodeRedemption?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // #213 — covers GET /tickets/mine (owner + optional status filter).
  @@index([ownerId, status])
  // #211 — seat uniqueness for assigned seats is enforced by a partial
  // unique index in a raw migration (see prisma/migrations/*_ticket_seat_partial_unique/migration.sql):
  // CREATE UNIQUE INDEX "Ticket_eventId_seat_key" ON "Ticket"("eventId", "seat")
  // WHERE "seat" <> 'unassigned'.
  // Prisma cannot express partial indexes, so no @@unique here by design.
}

model ResaleListing {
  id           String               @id @default(uuid())
  ticket       Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  seller       User                 @relation(fields: [sellerId], references: [id])
  sellerId     String
  price        BigInt
  status       ResaleListingStatus  @default(ACTIVE)
  txHash       String?
  expiresAt    DateTime?
  priceHistory ResalePriceHistory[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // #214 — resale lookups filter by ticket and status.
  @@index([ticketId, status])
}

model ResalePriceHistory {
  id              String        @id @default(uuid())
  resaleListing   ResaleListing @relation(fields: [resaleListingId], references: [id], onDelete: Cascade)
  resaleListingId String
  price           BigInt
  createdAt       DateTime      @default(now())

  @@index([resaleListingId])
}

model EventReminder {
  id      String   @id @default(uuid())
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  sentAt  DateTime @default(now())

  @@unique([eventId, userId])
}

/// A sold-out `TicketType`'s waitlist. Ordering is fair by construction: FIFO
/// on `createdAt`, with a unique (ticketTypeId, userId) pair so nobody can
/// buy a second place in line, and position is always computed by counting
/// earlier-`createdAt` WAITING rows rather than a mutable counter that could
/// drift out of order.
model WaitlistEntry {
  id             String              @id @default(uuid())
  ticketType     TicketType          @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  status         WaitlistEntryStatus @default(WAITING)
  /// Set when capacity opens up and this entry is offered a purchase window.
  offeredAt      DateTime?
  offerExpiresAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([ticketTypeId, userId])
  @@index([ticketTypeId, status, createdAt])
}

/// A discount code redeemable against primary sales for one `Event`.
model PromoCode {
  id              String                 @id @default(uuid())
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId         String
  /// Stored upper-cased; lookups normalize input the same way.
  code            String
  discountType    PromoCodeDiscountType
  /// Basis points (0-10000) when `discountType` is PERCENT; smallest-unit
  /// amount to subtract from price when FIXED.
  discountValue   Int
  /// Null means unlimited redemptions.
  maxRedemptions  Int?
  redemptionCount Int                    @default(0)
  expiresAt       DateTime?
  isActive        Boolean                @default(true)
  redemptions     PromoCodeRedemption[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([eventId, code])
}

/// One redemption of a `PromoCode` by a user, at most once each (the
/// unique constraint on [promoCodeId, userId] is the per-user usage limit;
/// `PromoCode.maxRedemptions` is the aggregate usage limit).
model PromoCodeRedemption {
  id          String    @id @default(uuid())
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  promoCodeId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  ticket      Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  ticketId    String?   @unique
  createdAt   DateTime  @default(now())

  @@unique([promoCodeId, userId])
}

/// A physical entrance/gate at an `Event`'s venue. Check-ins are attributed
/// to one via `Ticket.checkedInGateId`.
model Gate {
  id        String   @id @default(uuid())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  name      String
  checkIns  Ticket[]
  createdAt DateTime @default(now())

  @@unique([eventId, name])
}

/// A registered check-in scanner, scoped to one `Event`. Holds a hash of an
/// opaque bearer token issued once at registration (the raw token is never
/// stored) so a device's access can be revoked independently of any staff
/// member's JWT -- see `ScannerDeviceGuard`.
model ScannerDevice {
  id         String    @id @default(uuid())
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  name       String
  tokenHash  String    @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([eventId])
}

model WebhookEndpoint {
  id             String       @id @default(uuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  url            String
  secret         String
  events         String       @default("*")
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

/// #209 — audit trail for sensitive actions (org/event writes, ticket revokes).
/// Actor, action, entity and timestamp are stored; `metadata` carries
/// optional context (e.g. ticket ids, previous status).
model AuditLog {
  id         String   @id @default(uuid())
  /// User who performed the action. Null for system/cron actors.
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  /// E.g. "Organization", "Event", "Ticket".
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Records intent between a build-transaction call (e.g. `buildPurchaseTx`)
/// and its confirm call, so the window where a signed XDR exists but hasn't
/// been submitted/confirmed isn't a total black box. Rows are transient and
/// swept by `PendingTxCleanupService` once `expiresAt` has passed.
model PendingTx {
  id        String   @id @default(uuid())
  /// Discriminator for which build-transaction flow created this row, e.g.
  /// "issue", "purchase", "transfer", "check-in", "revoke", "list-resale",
  /// "cancel-resale", "buy-resale".
  type      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Arbitrary JSON snapshot of the parameters used to build the transaction,
  /// so a confirm call (or a support investigation) can inspect what was
  /// intended without re-deriving it.
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}
